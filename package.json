    "leaflet": "1.9.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/leaflet": "1.9.22",
    "tsx": "4.23.15"
  }
}
